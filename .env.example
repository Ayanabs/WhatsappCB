# WhatsApp Automation Bot — Environment Configuration
# Copy this file to .env and adjust if needed

# Custom non-default ports
API_PORT=5150
FRONTEND_PORT=5151

# (Optional) Override API URL if accessed behind reverse proxy or custom hostname
# PUBLIC_API_URL=http://localhost:5150

# (Docker) Address the published ports listen on. 0.0.0.0 = reachable from the
# network; 127.0.0.1 = only from the server itself (reverse proxy / SSH tunnel)
# BIND_IP=0.0.0.0

# (Docker) Container timezone for logs and the !time command
# TZ=Asia/Colombo

# Bot display name (used in logs)
BOT_NAME=WhatsApp Bot

# How often the task worker checks the config (in milliseconds)
# Default: 5000 (5 seconds)
WORKER_INTERVAL_MS=5000
